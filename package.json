{
  "name": "omp-codex-reserve",
  "version": "1.0.0",
  "description": "Expose the authenticated gpt-reserve Codex model in oh-my-pi (OMP) and Pi without replacing native model behavior.",
  "license": "MIT",
  "author": "mentalfl0w",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mentalfl0w/omp-codex-reserve.git"
  },
  "bugs": {
    "url": "https://github.com/mentalfl0w/omp-codex-reserve/issues"
  },
  "homepage": "https://github.com/mentalfl0w/omp-codex-reserve#readme",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./pi": "./dist/pi.js",
    "./omp": "./dist/omp.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "omp-extension",
    "pi",
    "pi-agent",
    "pi-package",
    "pi-extension",
    "openai",
    "codex",
    "gpt-reserve"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outfile dist/index.js --target bun && bun build src/pi.ts --outfile dist/pi.js --target bun && bun build src/omp.ts --outfile dist/omp.js --target bun",
    "test": "bun test test",
    "prepack": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "@oh-my-pi/pi-coding-agent": ">=18.0.11"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "omp": {
    "extensions": [
      "./dist/omp.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  }
}
